# CreatorAI Backend Environment Variables

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/creatorai?schema=public

# Authentication
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# Demo fixtures and non-production sample AI output. Keep disabled for real accounts.
DEMO_MODE=false

# Google Gemini AI Integration
GEMINI_API_KEY=

# Object Storage (Supabase or S3-compatible)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=creatorai-media

# Local Storage Directory (fallback when cloud storage is not configured)
LOCAL_STORAGE_DIR=./uploads
