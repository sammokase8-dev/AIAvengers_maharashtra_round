generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------
// 1. User & Profile
// ------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  avatarUrl    String?
  role         String   @default("creator") // creator, editor, admin
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile             CreatorProfile?
  assets              Asset[]
  projects            ContentProject[]
  platformConnections PlatformConnection[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  aiJobs              AIJob[]
  videoJobs           VideoProcessingJob[]
  publishingSchedules PublishingSchedule[]

  @@index([email])
}

model CreatorProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelName        String?
  niche              String?
  bio                String?
  primaryPlatform    String   @default("youtube")
  storageUsedBytes   BigInt   @default(0)
  storageLimitBytes  BigInt   @default(53687091200) // 50 GB
  languagePreference String   @default("en")
  themePreference    String   @default("system")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ------------------------------------------
// 2. Asset Library
// ------------------------------------------

model AssetFolder {
  id        String   @id @default(uuid())
  userId    String
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets Asset[]

  @@index([userId])
}

model AssetTag {
  id     String  @id @default(uuid())
  name   String  @unique
  assets Asset[]
}

model Asset {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId     String?
  folder       AssetFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  name         String
  originalName String
  type         String // video, image, audio, document, generated
  sizeBytes    BigInt
  mimeType     String
  url          String
  thumbnailUrl String?
  isFavorite   Boolean      @default(false)
  metadataJson Json? // duration, width, height, fps, bitrate, audioChannels
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tags             AssetTag[]
  transcripts      Transcript[]
  videoAnalyses    VideoAnalysis[]
  timelineSegments TimelineSegment[]
  clips            Clip[]

  @@index([userId])
  @@index([type])
  @@index([folderId])
}

// ------------------------------------------
// 3. Content Projects & Items
// ------------------------------------------

model ContentProject {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  status          String    @default("idea") // idea, draft, editing, review, scheduled, published
  niche           String?
  targetPlatforms String[] // youtube, instagram_reels, tiktok, linkedin, x
  tags            String[]
  thumbnailUrl    String?
  dueDate         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  contentItems        ContentItem[]
  scripts             Script[]
  timeline            Timeline?
  clips               Clip[]
  platformVariants    PlatformVariant[]
  publishingSchedules PublishingSchedule[]
  analytics           AnalyticsSnapshot[]

  @@index([userId])
  @@index([status])
}

model ContentItem {
  id        String         @id @default(uuid())
  projectId String
  project   ContentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  type      String // main_video, b_roll, thumbnail, hook_variant
  status    String         @default("draft")
  mediaUrl  String?
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([projectId])
}

// ------------------------------------------
// 4. Scripts & Transcripts
// ------------------------------------------

model Script {
  id          String         @id @default(uuid())
  projectId   String
  project     ContentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  rawText     String
  tone        String?        @default("conversational")
  wordCount   Int            @default(0)
  durationSec Float          @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  versions ScriptVersion[]

  @@index([projectId])
}

model ScriptVersion {
  id         String   @id @default(uuid())
  scriptId   String
  script     Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  versionNum Int      @default(1)
  content    String
  changeLog  String?
  createdAt  DateTime @default(now())

  @@index([scriptId])
}

model Transcript {
  id         String   @id @default(uuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fullText   String
  language   String   @default("en")
  confidence Float    @default(0.95)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  segments TranscriptSegment[]

  @@index([assetId])
}

model TranscriptSegment {
  id           String     @id @default(uuid())
  transcriptId String
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  startTime    Float // in seconds
  endTime      Float // in seconds
  text         String
  speaker      String?
  confidence   Float      @default(0.95)
  wordsJson    Json? // individual word timestamps

  @@index([transcriptId])
  @@index([startTime, endTime])
}

// ------------------------------------------
// 5. Video Analysis & Clips
// ------------------------------------------

model VideoAnalysis {
  id             String   @id @default(uuid())
  assetId        String
  asset          Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  summary        String?
  keyMomentsJson Json // detected hooks, scene changes, sentiment spikes
  topics         String[]
  viralityScore  Int      @default(80)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([assetId])
}

model Clip {
  id                   String          @id @default(uuid())
  projectId            String?
  project              ContentProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sourceAssetId        String
  sourceAsset          Asset           @relation(fields: [sourceAssetId], references: [id], onDelete: Cascade)
  title                String
  hook                 String
  startTime            Float
  endTime              Float
  duration             Float
  viralityScore        Int             @default(85)
  reasoning            String?
  recommendedPlatforms String[] // instagram_reels, tiktok, youtube_shorts
  aspectRatio          String          @default("9:16") // 9:16, 16:9, 1:1
  previewUrl           String?
  status               String          @default("pending") // pending, accepted, rejected, in_editor
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([sourceAssetId])
  @@index([projectId])
}

// ------------------------------------------
// 6. Timeline & Video Editing
// ------------------------------------------

model Timeline {
  id            String         @id @default(uuid())
  projectId     String         @unique
  project       ContentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  aspectRatio   String         @default("16:9")
  totalDuration Float          @default(0)
  audioSettings Json? // volume, background music track, ducking
  lastSavedAt   DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  segments      TimelineSegment[]
  captionTracks CaptionTrack[]

  @@index([projectId])
}

model TimelineSegment {
  id            String   @id @default(uuid())
  timelineId    String
  timeline      Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  sourceAssetId String
  sourceAsset   Asset    @relation(fields: [sourceAssetId], references: [id], onDelete: Cascade)
  startTime     Float // cut in source
  endTime       Float // cut end
  timelineStart Float // offset on master timeline
  speed         Float    @default(1.0)
  volume        Float    @default(1.0)
  trackIndex    Int      @default(0) // 0=main, 1=broll, 2=overlay
  cropJson      Json? // crop x, y, width, height, aspectRatio
  filtersJson   Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([timelineId])
  @@index([sourceAssetId])
}

model CaptionTrack {
  id         String   @id @default(uuid())
  timelineId String
  timeline   Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  language   String   @default("en")
  styleJson  Json? // typography, color, karaoke, position
  itemsJson  Json // array of caption items [{ startTime, endTime, text, words }]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([timelineId])
}

// ------------------------------------------
// 7. Platforms, Publishing & Schedules
// ------------------------------------------

model PlatformConnection {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform      String // youtube, instagram_reels, tiktok, linkedin, x
  accountHandle String?
  accountName   String?
  avatarUrl     String?
  accessToken   String? // encrypted
  refreshToken  String?
  expiresAt     DateTime?
  connected     Boolean   @default(false)
  followerCount Int       @default(0)
  connectedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, platform])
  @@index([userId])
}

model PlatformVariant {
  id             String         @id @default(uuid())
  projectId      String
  project        ContentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  platform       String // youtube, instagram_reels, tiktok, linkedin, x
  aspectRatio    String         @default("16:9")
  title          String
  description    String?
  hashtags       String[]
  ctaText        String?
  captionStyle   String         @default("minimal")
  maxDurationSec Int            @default(60)
  renderedUrl    String?
  status         String         @default("draft") // draft, ready, exporting, exported
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  publications Publication[]

  @@index([projectId])
  @@index([platform])
}

model PublishingSchedule {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId     String?
  project       ContentProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title         String
  description   String?
  platforms     String[] // platforms targeted
  scheduledTime DateTime
  status        String          @default("scheduled") // draft, scheduled, publishing, published, failed
  thumbnailUrl  String?
  mediaUrl      String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  publications Publication[]

  @@index([userId])
  @@index([status])
  @@index([scheduledTime])
}

model Publication {
  id                String              @id @default(uuid())
  scheduleId        String?
  schedule          PublishingSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  platformVariantId String?
  platformVariant   PlatformVariant?    @relation(fields: [platformVariantId], references: [id], onDelete: SetNull)
  platform          String
  externalPostId    String?
  publishedUrl      String?
  status            String              @default("published") // published, failed
  errorMessage      String?
  publishedAt       DateTime            @default(now())

  @@index([platform])
}

// ------------------------------------------
// 8. Analytics & Creator Intelligence
// ------------------------------------------

model AnalyticsSnapshot {
  id               String          @id @default(uuid())
  projectId        String?
  project          ContentProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  platform         String
  period           String // 7d, 30d, 90d, all
  views            BigInt          @default(0)
  likes            Int             @default(0)
  comments         Int             @default(0)
  shares           Int             @default(0)
  saves            Int             @default(0)
  watchTimeHours   Float           @default(0)
  retentionPercent Float           @default(0)
  engagementRate   Float           @default(0)
  recordedAt       DateTime        @default(now())

  @@index([projectId])
  @@index([platform])
  @@index([recordedAt])
}

model AIInsight {
  id                String   @id @default(uuid())
  userId            String
  category          String // performance, patterns, actions, opportunities
  title             String
  description       String
  severity          String   @default("info") // info, positive, warning, high_impact
  metricCurrent     String?
  metricBenchmark   String?
  recommendedAction String?
  isDismissed       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([category])
}

// ------------------------------------------
// 9. Background Jobs, Notifications & Audit
// ------------------------------------------

model AIJob {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String // hook, script, caption, cta, plan, repurpose, video_analysis
  status     String   @default("queued") // queued, processing, completed, failed
  progress   Int      @default(0) // 0-100
  inputJson  Json
  outputJson Json?
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model VideoProcessingJob {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // upload_processing, transcription, clip_extraction, ffmpeg_render
  status    String   @default("queued") // queued, processing, completed, failed
  progress  Int      @default(0)
  inputJson Json
  outputUrl String?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("info") // info, success, warning, error
  actionUrl String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String // auth.login, asset.upload, timeline.render, publish.dispatch
  entityType  String // Asset, Project, Clip, Timeline
  entityId    String?
  detailsJson Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
