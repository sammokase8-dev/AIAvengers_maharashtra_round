# Google Gemini AI Integration (optional key, intelligent creative fallback active when absent)
GEMINI_API_KEY=

# Object Storage
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=creatorai-media
LOCAL_STORAGE_DIR=./uploads

# Redis & Background Workers
REDIS_URL=redis://localhost:6379
